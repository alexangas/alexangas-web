---

<!doctype html>
<html lang="en" class="theme-light">
	<head>
		<BaseHead title="Home" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container section">
			<About />
		</main>
		<Footer />
	</body>
</html>
